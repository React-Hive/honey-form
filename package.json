{
  "name": "@react-hive/honey-form",
  "version": "6.1.0",
  "description": "The TS library to build the fully customized forms using React framework",
  "keywords": [
    "react",
    "form",
    "typescript"
  ],
  "homepage": "https://github.com/React-Hive/honey-form",
  "bugs": {
    "url": "https://github.com/React-Hive/honey-form/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/React-Hive/honey-form.git"
  },
  "author": "Mykhailo Aliinyk <m.aliynik@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "webpack --config webpack.config.mjs",
    "build-docs": "NODE_ENV=production webpack -c webpack-docs.config.js",
    "test": "jest --collect-coverage"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.mjs",
    "require": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "!dist/**/__mocks__",
    "!dist/**/__tests__",
    "!dist/**/jest*"
  ],
  "peerDependencies": {
    "@mdx-js/react": "3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@react-hive/honey-utils": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@mdx-js/loader": "3.1.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "29.5.14",
    "@types/mdx": "2.0.13",
    "@types/node": "22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "copy-webpack-plugin": "13.0.0",
    "eslint": "9.32.0",
    "eslint-plugin-react": "7.37.5",
    "html-webpack-plugin": "5.6.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.6.2",
    "ts-jest": "29.4.0",
    "ts-loader": "9.5.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.39.0",
    "webpack": "5.101.0",
    "webpack-cli": "6.0.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/src/**/__tests__/**/*.tsx"
    ]
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}