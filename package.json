{
  "name": "@react-hive/honey-form",
  "version": "8.15.0",
  "description": "The TS library to build the fully customized forms using React framework",
  "keywords": [
    "react",
    "form",
    "typescript"
  ],
  "homepage": "https://github.com/React-Hive/honey-form",
  "bugs": {
    "url": "https://github.com/React-Hive/honey-form/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/React-Hive/honey-form.git"
  },
  "author": "Mike Aliinyk <m.aliynik@gmail.com>",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "webpack --config webpack.config.mjs",
    "build-docs": "NODE_ENV=production webpack -c webpack-docs.config.js",
    "test": "vitest",
    "prepublishOnly": "CI=1 pnpm clean && pnpm test && pnpm build"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.dev.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/__mocks__",
    "!dist/**/__tests__"
  ],
  "peerDependencies": {
    "@mdx-js/react": "3.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@react-hive/honey-utils": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdx-js/loader": "3.1.1",
    "@testing-library/react": "16.3.2",
    "@types/mdx": "2.0.13",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react": "7.37.5",
    "html-webpack-plugin": "5.6.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}
