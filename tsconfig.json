{
  "compilerOptions": {
    "lib": ["dom", "ESNext"],
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "strict": false
  },
  "include": ["src"],
  "files": ["src/global.d.ts"]
}