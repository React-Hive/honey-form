{
  "compilerOptions": {
    "strict": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src"],
  "files": ["src/global.d.ts"]
}
